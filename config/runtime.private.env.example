# Replace these placeholders with approved endpoints inside the institution's private environment.
CREDITDOC_RAG_INDEX=.local/production-index.json
CREDITDOC_RAG_GENERATOR=private_model
CREDITDOC_RAG_DOCUMENT_PARSER=private
CREDITDOC_RAG_PRECHECK_POLICY=config/precheck.json
CREDITDOC_RAG_API_TOKENS='{"replace-with-secret-from-secret-manager":{"subject":"reviewer-service","institution":"REPLACE_WITH_INSTITUTION_ID","product_lines":["REPLACE_WITH_PRODUCT_LINE"]}}'
CREDITDOC_RAG_AUDIT_PATH=.local/audit.jsonl
CREDITDOC_PRECHECK_JOBS_DB=.local/precheck-jobs.sqlite
CREDITDOC_PRECHECK_WORKERS=2
CREDITDOC_PRECHECK_QUEUE_TIMEOUT_SECONDS=90
CREDITDOC_PRECHECK_DEADLINE_SECONDS=180
CREDITDOC_PRECHECK_BACKLOG_MAX=200
CREDITDOC_RAG_DOCUMENT_PARSER_URL=http://127.0.0.1:9003
CREDITDOC_RAG_DOCUMENT_PARSER_MODEL=replace-with-internal-ocr-vl-extractor
CREDITDOC_RAG_DOCUMENT_PARSER_API_KEY=
CREDITDOC_RAG_DOCUMENT_PARSER_ALLOWED_HOSTS=
CREDITDOC_RAG_HOST=127.0.0.1
CREDITDOC_RAG_PORT=8080

# OpenAI-compatible chat completion endpoint
CREDITDOC_RAG_LLM_BASE_URL=http://127.0.0.1:9000/v1
CREDITDOC_RAG_LLM_MODEL=replace-with-approved-chat-model
CREDITDOC_RAG_LLM_API_KEY=
CREDITDOC_RAG_LLM_ALLOWED_HOSTS=

# Optional OpenAI-compatible embedding endpoint. Index and query must use the same model.
CREDITDOC_RAG_EMBEDDING_BASE_URL=http://127.0.0.1:9001/v1
CREDITDOC_RAG_EMBEDDING_MODEL=replace-with-approved-embedding-model
CREDITDOC_RAG_EMBEDDING_API_KEY=
CREDITDOC_RAG_EMBEDDING_ALLOWED_HOSTS=

# Optional Cohere-compatible /rerank endpoint
CREDITDOC_RAG_RERANK_BASE_URL=http://127.0.0.1:9002/v1
CREDITDOC_RAG_RERANK_MODEL=replace-with-approved-reranker
CREDITDOC_RAG_RERANK_API_KEY=
CREDITDOC_RAG_RERANK_ALLOWED_HOSTS=
